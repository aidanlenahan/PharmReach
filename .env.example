GEMINI_API_KEY=
# Optional chat overrides (backend/chat.py defaults apply when empty)
# Defaults to gemini-3.5-flash-lite (verified for catalog matching)
GEMINI_MODEL=
CHAT_IP_RPM=
CHAT_GLOBAL_RPM=

NJ_TRANSIT_API_KEY=

# NJ TRANSIT developer portal login for the GTFS token API (backend/njt/refresh.py).
# Optional: without it the refresh job uses the public rail_data.zip / bus_data.zip.
# On the server put these in /etc/hackru.env instead.
NJT_USERNAME=
NJT_PASSWORD=

# Browser key for Google Places address autocomplete on the starting-location field.
# Baked into the frontend bundle at build time: restrict it by HTTP referrer and to Places API (New) + Maps JavaScript API.
GOOGLE_API_KEY=
