# NJ Transit developer portal credentials (https://developer.njtransit.com).
# Only needed for `npm run fetch:api` and the credentialed live tests; `npm run fetch` uses the public zips.
NJT_USERNAME=
NJT_PASSWORD=
# Optional: pre-issued tokens. When set they override data/tokens.json and are never auto-refreshed.
NJT_RAIL_TOKEN=
NJT_BUS_TOKEN=
# Optional: set to 1 to run the rail getToken bad-credentials live test. It makes one getToken call,
# and rail getToken + isValidToken share a limit of 10 calls/day, so it is off by default.
NJT_TEST_RAIL_AUTH=
