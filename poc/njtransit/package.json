{
  "name": "njtransit-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 1 proof of concept: NJ Transit GTFS stops + heuristic transit logic for Pharmacy Searcher",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "explore": "tsx scripts/explore.ts",
    "fetch": "tsx scripts/fetch.ts --source public",
    "fetch:api": "tsx scripts/fetch.ts --source api"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
